# =============================================================================
# Contact Management System - .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Security & Sensitive Data
# -----------------------------------------------------------------------------
*.key
*.age
*.env
*.env.test
.temp_age/
.temp_key
public_keys/
private_keys/

# -----------------------------------------------------------------------------
# System & OS Files
# -----------------------------------------------------------------------------
.DS_Store
.directory
Thumbs.db
*~

# -----------------------------------------------------------------------------
# IDE & Editor Files
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.kate-swp

# -----------------------------------------------------------------------------
# Node.js & NPM
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
.npm/
*.tgz
.yarn-integrity
/_temp
# Block temp files and documentation
.pnp.*
.pnp/

# -----------------------------------------------------------------------------
# Python Environment
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
env/
ENV/

# -----------------------------------------------------------------------------
# Development & Testing
# -----------------------------------------------------------------------------
*.log
logs/
coverage/
test-results/
.ipynb_checkpoints
*.db

# -----------------------------------------------------------------------------
# Build & Compilation Artifacts
# -----------------------------------------------------------------------------
backend/main
frontend/build/
*.zip

# -----------------------------------------------------------------------------
# Cache & Generated Files
# -----------------------------------------------------------------------------
cache-versions.json
index.html.backup

# -----------------------------------------------------------------------------
# Project-Specific Patterns
# -----------------------------------------------------------------------------
# Temporary and backup files
*.old
*.backup

# Cloudflare Wrangler
.wrangler/

# Cache bust temporary files
.cache-bust-*

# Deployment and temporary directories
_deploy_tmp/
_temp/

# Test files (keep test framework config, ignore test implementations)
test-*.html
test-*.js
test-*.sh
test-*.fish
test-*.cjs
test-*.vcf

# Demo and diagnostic files
demo-*.html
diagnose-*.html
diagnose-*.sh

# Development scripts (you may want to keep some of these)
*-dev.sh
start-dev.sh
restore-dev.sh
dev-cache-bust.sh

# Production and deployment scripts
production_zip*.sh
setup-cloudflare.sh
emergency-stop-sync.sh
force-refresh.sh
nuclear-cache-clear.sh
cache-bust.sh
check-status.sh
clean-*.sh
cleanup-*.sh
manual-cleanup-*.sh
reduce-logging.sh
remove-bind-calls.sh
verify-*.sh
open-*.sh

# VCF test data files
*.vcf

# Personal notes and todo files (in parent directory)
../*.txt
../icons8-*.png
*.bup
*.backup
*temp*
*tmp*
*fixes*
*test*
*example*

# Debug and test HTML files (keep main ones)
*debug*.html
*fix*.html
*test*.html
*demo*.html
*example*.html
*sample*.html
*troubleshoot*.html
*quick*.html
*diagnose*.html
*verify*.html

# Cache bust temporary files
.cache-bust-*

# Data files that shouldn't be in git
*.vcf
*.txt
*.blob
*.meta
*.followers

# Project folders
/tools
/tests
frontend/test-app/

# Bridge diagnostic scripts (temporary development files)
contact-carddav-bridge-lite/diagnostic-*.js
contact-carddav-bridge-lite/discover-*.js
contact-carddav-bridge-lite/setup-*.js

# Documentation files (except essential ones)
*.md
!README.md
!LICENSE.md
!SECURITY_REVIEW.md
!FEATURE_CLEANUP_AND_REVIEW.md

# Configuration files (be selective)
*.yml
*.json
!package.json

# -----------------------------------------------------------------------------
# Shell Scripts - All ignored (dev/build scripts are project-specific)
# -----------------------------------------------------------------------------
*.sh

# -----------------------------------------------------------------------------
# Allow Essential Files
# -----------------------------------------------------------------------------
!index.html
!404.html
!robots.txt
!favicon.ico
