# =============================================================================
# Contact Management System - .gitignore (whitelist approach)
# Everything is ignored by default; only the files listed below are tracked.
# Local-only areas: scripts/, docs/, tests/manual/, tools/, .github/
# =============================================================================

# Ignore everything by default
*

# Allow git to descend into directories
!*/

# Always ignore, even under allowed paths
node_modules/
.wrangler/

# --- Application ---
!/.gitignore
!/index.html
!/404.html
!/favicon.ico
!/manifest.webmanifest
!/assets/**
!/_headers
!/package.json
!/package-lock.json
!/jest.config.js
!/LICENSE
!/README.md
!/cache-bust.js
!/style.css
!/style-dark.css
!/mobile.css
!/mobile-dark.css

# --- Source ---
!/lib/**
!/src/**

# --- Cloudflare Worker (deployed separately via wrangler) ---
!/cloudflare-worker/carddav-proxy.js
!/cloudflare-worker/package.json
!/cloudflare-worker/package-lock.json
!/cloudflare-worker/wrangler.toml
!/cloudflare-worker/README.md

# --- Tests (jest suite; tests/manual/ debug pages stay local-only) ---
!/tests/*.js
!/tests/*.vcf
!/tests/icloud/**
!/tests/sharing/**
